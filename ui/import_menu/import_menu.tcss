Screen {
    align: center middle
}

.section {
    align: center middle;
    width: 50%;
    height: 100%;
    border: ascii green;
}

.section-title {
    width: 100%;
    content-align: left middle;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
    border-bottom: solid $accent;
    padding-bottom: 1;
    padding-left: 1;
    dock: top;
}

#file-select {
    align: center middle;
    width: 100%;
    border: ascii green;
}

.tree-row {
    width: 90%;
    height: auto;
    align: left middle;
    margin: 1;
    border: ascii green;
}

.tree {
    width: auto;
    height: auto;
}

#confirm-row {
    width: 100%;
    height: 5;
    align: center middle;
    border: ascii green;
}

#app-status {
    align: center middle;
    width: 100%;
    /*border: round $primary;*/
    outline: ascii green;
    dock: bottom;
}

.status-box {
    width: 33%;
    padding: 0 1;
    align: center middle;
    margin: 1;
}
