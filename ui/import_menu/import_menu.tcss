#import-menu {
    layout: horizontal;
    align: center top;
}

#file-select {
    align: center top;
    width: 100%;
}

.tree-row {
    width: 90%;
    height: auto;
    align: left top;
    margin: 1;
}

.tree {
    width: auto;
    height: auto;
}

#confirm-row {
    margin-top: 2;
    align: center middle;
}

#confirm {
    content-align: center middle;
}

