Screen {
    layout: horizontal;
    align: center top;
}

.section {
    align: center top;
    width: 50%;
}

.section-title {
    content-align: left middle;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
    border-bottom: solid $accent;
    padding-bottom: 1;
    padding-left: 1;
    dock: top;
}

#file-select {
    align: center top;
    width: 100%;
}

.tree-row {
    width: 90%;
    height: auto;
    align: left top;
    margin: 1;
}

.tree {
    width: auto;
    height: auto;
}

#confirm-row {
    margin-top: 2;
    align: center middle;
}

#confirm {
    content-align: center middle;
}

