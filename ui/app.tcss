.section {
    align: center top;
    width: 1fr;
}

.section-title {
    content-align: left middle;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
    border-bottom: solid $accent;
    padding-bottom: 1;
    padding-left: 1;
    dock: top;
}

#app-status {
    align: center bottom;
    width: auto;
    border: round $primary;
    dock: bottom;
    padding: 1;
}

.status-row {
    height: 2;
    width: auto;
}

.status {
    width: 20;
    height: 2;
}

.number {
    width: 3;
    height: 2;
    color: green;
}

ModalScreen {
    align: center middle;
}

AccountPicker {
    align: center top;
}

.dialog {
    width: auto;
    height: auto;
    padding: 2;
    border: round $accent;
    background: $surface;
    align: center middle;
}


.dialog Label {
    text-style: bold;
    margin: 1;
}

.dialog Button {
    width: 100%;
    margin: 1;
}

.dialog Datatable {
    width: auto;
    height: auto;
    margin-top: 1;
}

.dialog Input {
    width: 50;
    height: auto;
}

.dialog HorizontalGroup {
    width: auto;
    height: auto;
    align: center middle
}

.dialog HorizontalGroup Select {
    width: 1fr;
    height: auto;
    margin: 1;
}

.dialog HorizontalGroup Button {
    width: 1fr;
    height: auto;
    margin: 1;
}
