.section {
    align: center top;
    width: 1fr;
}

.section-title {
    content-align: left middle;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
    border-bottom: solid $accent;
    padding-bottom: 1;
    padding-left: 1;
    dock: top;
}

#app-status {
    align: center bottom;
    width: auto;
    border: round $primary;
    dock: bottom;
    padding: 1;
}

.status-row {
    height: 2;
    width: auto;
}

.status {
    width: 20;
    height: 2;
}

.number {
    width: 3;
    height: 2;
    color: green;
}

ConfirmScreen {
    align: center middle;
}

#append-dialog {
    width: 50;
    height: auto;
    padding: 2;
    border: round $accent;
    background: $surface;
    align: center middle;
}

#confirm-dialog Button {
    width: 100%;
    margin-top: 1;
}

ConfirmAppendScreen {
    align: center middle;
}

#append-dialog {
    width: auto;
    height: auto;
    padding: 2;
    border: round $accent;
    background: $surface;
    align: center middle;
}

#append-dialog Button {
    width: 100%;
    margin-top: 1;
}
