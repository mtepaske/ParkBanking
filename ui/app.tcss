.section {
    align: center top;
    width: 1fr;
}

/* Menus */
.section-title {
    content-align: left middle;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
    border-bottom: solid $accent;
    padding-bottom: 1;
    padding-left: 1;
    dock: top;
}

.input-row {
    align: left middle;
    width: auto;
    height: 3;
    margin: 1;
}

.input-row Static {
    content-align: left middle;
    text-style: bold;
    width: 20;
    height: 3;
}

.input-row Input {
    width: 40;
    height: 3;
}

.input-row MaskedInput {
    width: 40;
    height: 3;
}

.select-row {
    align: left middle;
    width: auto;
    height: 3;
    margin: 1;
}

.select-label {
    content-align: left middle;
    text-style: bold;
    width: 20;
    height: 3;
}

.select-row Select {
    width: 40;
    height: 3;
}

.switch-row {
    align: left middle;
    width: 60;
    height: 3;
    margin: 1;
}

.switch-row Static {
    content-align: left middle;
    text-style: bold;
    width: 40;
    height: 3;
}

.switch-row Switch {
    width: auto;
    height: 3;
}

.tree-row {
    align: left top;
    width: 90%;
    height: auto;
    margin: 1;
}

.tree {
    width: auto;
    height: auto;
}

/* Application status box */
.status-box {
    align: center bottom;
    width: auto;
    border: round $primary;
    padding: 1;
    dock: bottom;
}

.status-row {
    width: auto;
    height: 2;
}

.status {
    width: 30;
    height: 2;
}

.number {
    width: 3;
    height: 2;
    color: green;
}

/* Popup Screens */
ModalScreen {
    align: center middle;
}

AccountPicker {
    align: center top;
}

.dialog {
    align: center middle;
    width: auto;
    height: auto;
    border: round $accent;
    background: $surface;
    padding: 2;
}

.dialog-title {
    align: center middle;
    width: auto;
    height: auto;
    border: round $primary;
}

.dialog Label {
    text-style: bold;
    margin: 1;
}

.dialog Button {
    width: 100%;
    margin: 1;
}

.append-title {
    align: center middle;
    width: 120;
    height: auto;
    border: round $primary;
}

.dialog-header {
    align: center middle;
    width: 100%;
    height: auto;
    border: round $primary;
}

.stack-row {
    align: center middle;
    width: auto;
    height: auto;
}

.input-stack {
    align: center middle;
    width: auto;
    height: auto;
}

.input-stack MaskedInput {
    width: 40;
    height: 3;
}

.dialog .label-stack {
    align: center middle;
    width: 100%;
    height: auto;
}

.label-stack #context {
    color: green;
}

ConfirmChargesScreen .dialog-title {
    width: 100%;
}

.dialog .charge-table {
    width: auto;
    height: auto;
}

.dialog .table-row {
    align: center middle;
    width: 120;
    height: auto;
}

.dialog .accounts-table {
    width: 1fr;
    height: auto;
    margin: 1;
}

.dialog #amount {
    width: 50;
    height: auto;
}

.dialog #history {
    width: auto;
}

ProccessUnknownScreen .row {
    width: auto;
    height: auto;
}

ProccessUnknownScreen .row Select {
    width: 50;
    height: auto;
    margin: 1;
}

ProccessUnknownScreen .row Button {
    width: 50;
    height: auto;
    margin: 1;
}

.test {
    border: ascii green;
}
