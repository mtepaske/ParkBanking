#view-account-menu {
    layout: horizontal;
    align: center top;
}

.section-title {
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
    border-bottom: solid $accent;
    padding-bottom: 1;
}

#actions {
    width: 100%;
    height: auto;
    align: center middle;
}

#actions Button {
    width: 40;
    height: 5;
    margin: 1;
    content-align: center middle;
}

.settings-title {
    text-style: bold;
    width: 60;
    margin-top: 1;
    margin-bottom: 1;
    border: solid $primary;
    content-align: center middle;
}
