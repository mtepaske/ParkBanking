#export-menu {
    layout: horizontal;
    align: center top;
}

#file-select {
    align: center top;
    width: 100%;
}

#confirm-stack {
    align: center middle;
    margin-top: 2;
    width: 100%;
    height: auto;
}

#name-row {
    height: auto;
    align: center middle;
}

#file-name {
    width: 70%;
    height: auto;
    content-align: center middle;
    margin: 1;
}

#confirm-row {
    height: auto;
    align: center middle;
}

#confirm {
    content-align: center middle;
    width: 30%;
    margin: 1;
}
