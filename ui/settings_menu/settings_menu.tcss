.input-row {
    width: auto;
    height: 3;
    align: left middle;
    margin: 1;
}

.input-label {
    text-style: bold;
    width: 20;
    height: 3;
    content-align: left middle;
}

.input-row Input {
    width: 40;
    height: 3;
}

.input-row MaskedInput {
    width: 40;
    height: 3;
}

.tree-row {
    width: 90%;
    height: auto;
    align: left middle;
    margin: 1;
}

.tree {
    width: auto;
    height: auto;
}

.select-row {
    width: auto;
    height: 3;
    align: left middle;
    margin: 1;
}

.select-label {
    text-style: bold;
    width: 20;
    height: 3;
    content-align: left middle;
}

.select-row Select {
    width: 40;
    height: auto;
}

.switch-row {
    width: 60;
    height: 3;
    align: left middle;
    margin: 1;
}

.switch-label {
    text-style: bold;
    width: 40;
    height: 3;
    content-align: left middle;
}

.switch-row Switch {
    width: auto;
    height: 3;
}
